local serverStatus  = "online"
local customMessage = nil
local customEta     = nil
local forceWebhook  = false
local rawAAA        = ""

pcall(function()
    rawAAA = game:HttpGet(STATUS_URL.."?cb="..tostring(os.time())) or ""
    local clean = rawAAA:gsub("\r", "")

    local hasKV = false
    for line in clean:gmatch("[^\n]+") do
        local k, v = line:match("^%s*([%w_]+)%s*=%s*(.-)%s*$")
        if k and v then
            hasKV = true
            k = k:lower()
            if k == "status" then
                serverStatus = v:lower():gsub("%s+", "")
            elseif k == "message" or k == "msg" then
                customMessage = v
            elseif k == "eta" then
                customEta = v
            elseif k == "force" then
                forceWebhook = (v:lower() == "true" or v == "1")
            end
        end
    end

    if not hasKV then
        serverStatus = clean:gsub("%s+", ""):lower()
    end
end)

