local function sendStatusWebhook()
    if not request then return end
    if not (statusChanged or forceWebhook) then return end

    local fields = {
        {name = "Status", value = sc.circle.." **"..sc.text.."**", inline = true},
    }
    if customEta then
        table.insert(fields, {name = "ETA", value = customEta, inline = true})
    end

    local data = {
        content = "@here",
        allowed_mentions = { parse = {"everyone"} },
        embeds = {{
            title       = "Avocat Hub — Status Update",
            description = displayMessage,
            color       = sc.hex,
            fields      = fields,
            footer      = { text = "Avocat Hub · v1.0" },
        }}
    }

    pcall(function()
        request({
            Url     = WEBHOOK_STATUS,
            Method  = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body    = HS:JSONEncode(data)
        })
    end)
end
