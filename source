pcall(function()
    local player = game:GetService("Players").LocalPlayer
    local pg = player:WaitForChild("PlayerGui")

    local old = pg:FindFirstChild("AvocatLoader")
    if old then
        old:Destroy()
    end
end)

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local LP = Players.LocalPlayer
local HUB_URL = "https://raw.githubusercontent.com/Avocat547/Avocat-Hubbb/main/hub.lua"

local gui = Instance.new("ScreenGui")
gui.Name = "AvocatLoader"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = LP:WaitForChild("PlayerGui")

local box = Instance.new("Frame")
box.Parent = gui
box.AnchorPoint = Vector2.new(0.5, 0.5)
box.Position = UDim2.new(0.5, 0, 0.5, 0)
box.Size = UDim2.new(0, 320, 0, 80)
box.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
box.BorderSizePixel = 0

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = box

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(45, 45, 45)
stroke.Thickness = 1
stroke.Parent = box

local title = Instance.new("TextLabel")
title.Parent = box
title.BackgroundTransparency = 1
title.Position = UDim2.new(0, 18, 0, 14)
title.Size = UDim2.new(1, -36, 0, 20)
title.Font = Enum.Font.GothamBold
title.Text = "Avocat Hub"
title.TextColor3 = Color3.fromRGB(235, 235, 235)
title.TextSize = 14
title.TextXAlignment = Enum.TextXAlignment.Left

local percent = Instance.new("TextLabel")
percent.Parent = box
percent.BackgroundTransparency = 1
percent.Position = UDim2.new(1, -60, 0, 14)
percent.Size = UDim2.new(0, 42, 0, 20)
percent.Font = Enum.Font.GothamMedium
percent.Text = "0%"
percent.TextColor3 = Color3.fromRGB(170, 170, 170)
percent.TextSize = 13
percent.TextXAlignment = Enum.TextXAlignment.Right

local barBg = Instance.new("Frame")
barBg.Parent = box
barBg.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
barBg.BorderSizePixel = 0
barBg.Position = UDim2.new(0, 18, 0, 48)
barBg.Size = UDim2.new(1, -36, 0, 6)

local barBgCorner = Instance.new("UICorner")
barBgCorner.CornerRadius = UDim.new(1, 0)
barBgCorner.Parent = barBg

local barFill = Instance.new("Frame")
barFill.Parent = barBg
barFill.BackgroundColor3 = Color3.fromRGB(155, 155, 155)
barFill.BorderSizePixel = 0
barFill.Size = UDim2.new(0, 0, 1, 0)

local barFillCorner = Instance.new("UICorner")
barFillCorner.CornerRadius = UDim.new(1, 0)
barFillCorner.Parent = barFill

local function setProgress(value)
    value = math.clamp(value, 0, 100)
    percent.Text = tostring(value) .. "%"

    TweenService:Create(barFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(value / 100, 0, 1, 0)
    }):Play()
end

for i = 1, 70 do
    setProgress(i)
    task.wait(0.015)
end

local source
local okGet, getErr = pcall(function()
    source = game:HttpGet(HUB_URL .. "?cb=" .. tostring(os.time()))
end)

if not okGet or not source or source == "" then
    setProgress(0)
    warn("[Avocat Hub] GitHub load failed:", getErr or "empty response")
    task.wait(1)
    gui:Destroy()
    return
end

for i = 71, 100 do
    setProgress(i)
    task.wait(0.01)
end

task.wait(0.2)
gui:Destroy()

local fn, compileErr = loadstring(source)

if not fn then
    warn("[Avocat Hub] Lua compile error:", compileErr)
    return
end

local okRun, runErr = pcall(fn)

if not okRun then
    warn("[Avocat Hub] Runtime error:", runErr)
end
