local function parseAAA(raw)
    local s, m, e = "online", "", ""
    local clean = raw:gsub("\r", "")
    local hasKV = false
    for line in clean:gmatch("[^\n]+") do
        local k, v = line:match("^%s*([%w_]+)%s*=%s*(.-)%s*$")
        if k and v then
            hasKV = true
            k = k:lower()
            if k == "status" then s = v:lower():gsub("%s+", "")
            elseif k == "message" or k == "msg" then m = v
            elseif k == "eta" then e = v
            end
        end
    end
    if not hasKV then s = clean:gsub("%s+", ""):lower() end
    return s, m, e
end

local function buildAAA(s, m, e)
    local out = "status="..s
    if m and m ~= "" then out = out.."\nmessage="..m end
    if e and e ~= "" then out = out.."\neta="..e end
    return out
end

