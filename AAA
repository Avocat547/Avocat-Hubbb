local b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64encode(data)
    return ((data:gsub('.', function(x)
        local r, b = '', x:byte()
        for i = 8, 1, -1 do r = r .. (b % 2^i - b % 2^(i-1) > 0 and '1' or '0') end
        return r
    end) .. '0000'):gsub('%d%d%d?%d?%d?%d?', function(x)
        if #x < 6 then return '' end
        local c = 0
        for i = 1, 6 do c = c + (x:sub(i,i) == '1' and 2^(6-i) or 0) end
        return b64chars:sub(c+1, c+1)
    end) .. ({'', '==', '='})[#data % 3 + 1])
end

local API_URL = "https://api.github.com/repos/"..GITHUB_OWNER.."/"..GITHUB_REPO.."/contents/"..GITHUB_FILE

local function ghGet()
    local res = request({
        Url = API_URL.."?ref="..GITHUB_BRANCH,
        Method = "GET",
        Headers = {
            ["Authorization"] = "Bearer "..GITHUB_TOKEN,
            ["Accept"] = "application/vnd.github+json",
            ["User-Agent"] = "AvocatHub-Admin",
            ["X-GitHub-Api-Version"] = "2022-11-28"
        }
    })
    return res
end

local function ghPut(newContent, sha)
    local body = {
        message = "Update AAA via admin panel",
        content = b64encode(newContent),
        branch  = GITHUB_BRANCH,
    }
    if sha then body.sha = sha end

    local res = request({
        Url = API_URL,
        Method = "PUT",
        Headers = {
            ["Authorization"]        = "Bearer "..GITHUB_TOKEN,
            ["Accept"]               = "application/vnd.github+json",
            ["Content-Type"]         = "application/json",
            ["User-Agent"]           = "AvocatHub-Admin",
            ["X-GitHub-Api-Version"] = "2022-11-28"
        },
        Body = HS:JSONEncode(body)
    })
    return res
end

