local function loadCurrent()
    log("Fetching current AAA...", Color3.fromRGB(150, 150, 200))
    local ok, res = pcall(ghGet)
    if not ok or not res then
        log("Network error.", Color3.fromRGB(255, 100, 100))
        return
    end
    if res.StatusCode ~= 200 then
        log("GET failed: HTTP "..tostring(res.StatusCode), Color3.fromRGB(255, 100, 100))
        return
    end
    local info = HS:JSONDecode(res.Body)
    currentSha = info.sha
    local raw = ""
    pcall(function()
        raw = game:HttpGet("https://raw.githubusercontent.com/"..GITHUB_OWNER.."/"..GITHUB_REPO.."/refs/heads/"..GITHUB_BRANCH.."/"..GITHUB_FILE.."?cb="..tick())
    end)
    local s, m, e = parseAAA(raw)
    currentStatus  = s
    currentMessage = m
    currentEta     = e
    selectedStatus = (s == "online" or s == "maintenance" or s == "offline") and s or "online"
    msgBox.Text = m
    etaBox.Text = e
    updateStatusBtns()
    log("Loaded: "..s, Color3.fromRGB(100, 200, 100))
end

local applying = false
applyBtn.MouseButton1Click:Connect(function()
    if applying then return end
    applying = true
    applyBtn.Text = "Applying..."
    log("Pushing to GitHub...", Color3.fromRGB(150, 150, 200))

    local newContent = buildAAA(selectedStatus, msgBox.Text, etaBox.Text)

    if not currentSha then
        pcall(function()
            local res = ghGet()
            if res and res.StatusCode == 200 then
                local info = HS:JSONDecode(res.Body)
                currentSha = info.sha
            end
        end)
    end

    local ok, res = pcall(ghPut, newContent, currentSha)
    if not ok or not res then
        log("Network error during PUT.", Color3.fromRGB(255, 100, 100))
    elseif res.StatusCode == 200 or res.StatusCode == 201 then
        log("Pushed successfully. Status = "..selectedStatus, Color3.fromRGB(100, 200, 100))
        local info = HS:JSONDecode(res.Body)
        if info.content and info.content.sha then
            currentSha = info.content.sha
        end
    elseif res.StatusCode == 409 then
        log("Conflict — refreshing SHA...", Color3.fromRGB(255, 180, 60))
        currentSha = nil
        loadCurrent()
    elseif res.StatusCode == 401 then
        log("Auth error: bad GitHub token.", Color3.fromRGB(255, 100, 100))
    elseif res.StatusCode == 404 then
        log("Repo or file not found.", Color3.fromRGB(255, 100, 100))
    else
        log("Failed: HTTP "..tostring(res.StatusCode), Color3.fromRGB(255, 100, 100))
    end
    applyBtn.Text = "Apply Changes"
    applying = false
end)

